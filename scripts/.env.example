# Copy to .env and fill the settings you need.

# GitHub API and Packages authentication.
GITHUB_ACTOR=your-username
GITHUB_TOKEN=

# Optional GitLab API token.
GITLAB_TOKEN=

# Optional Telegram notifications.
TG_TOKEN=
TG_CHAT=

# Optional Java 21 installation directory.
# JAVA_HOME="/path/to/jdk-21"

# Optional local summary.
# GITHUB_STEP_SUMMARY=temp/summary.md
