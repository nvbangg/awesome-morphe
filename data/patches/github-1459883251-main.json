        {
            "name": "Bypass Stock Limit",
            "description": "Restores the features that the stock keyboard only allows to the privileged stock build: the cloud signers, the configuration sync and the SecKit identity report \"com.oplus.keyboard\", the translation and theme requests embed it, and the AI writing key opens the AI writer through its unprotected text selection entrance instead of the \"com.oplus.permission.safe.SAU\" protected service.",
            "default": false,
            "category": null,
            "compatiblePackages": [
                {
                    "packageName": "com.oplus.keyboard",
                    "name": "Oplus Keyboard",
                    "description": null,
                    "apkFileType": "APK",
                    "appIconColor": "#1D7A4D",
                    "signatures": null,
                    "targets": [
                        {
                            "version": null,
                            "versionCodes": null,
                            "isExperimental": false,
                            "minSdk": null,
                            "description": null
                        }
                    ]
                }
            ],
            "options": []
        },
        {
            "name": "Change Identity",
            "description": "Gives the patched keyboard its own identity so it can coexist with the privileged, stock-signed build: the package becomes \"com.realme.keyboard\", the launcher and input method picker label becomes \"realmeow Keyboard\" / \"真奇喵输入法\" / \"真奇喵輸入法\" by locale, and everything the rename would otherwise break is repaired (provider authorities, the dynamic receiver permission, the exported IME service and the hardcoded content:// authorities).",
            "default": false,
            "category": null,
            "compatiblePackages": [
                {
                    "packageName": "com.oplus.keyboard",
                    "name": "Oplus Keyboard",
