      "options": [
        {
          "key": "appName",
          "title": "App name",
          "description": "Name under the icon and in Settings. Empty keeps the original (or the preset's name).",
          "required": false,
          "type": "kotlin.String",
          "default": null,
          "values": null
        },
        {
          "key": "preset",
          "title": "Preset",
          "description": "A built-in look (icon and name). Ignored when an icon image is set.",
          "required": false,
          "type": "kotlin.String",
          "default": null,
          "values": {
            "None": "",
            "Play Music": "play_music",
            "Play Books": "play_books",
            "Play Games": "play_games",
            "Podcasts": "podcasts",
            "Keep Notes": "keep",
            "Fit": "fit",
            "Translate": "translate",
            "Google News": "news",
            "Earth": "earth",
            "Kaspersky": "kaspersky",
            "AVG AntiVirus": "avg",
            "Norton 360": "norton",
            "McAfee Security": "mcafee",
            "Malwarebytes": "malwarebytes",
            "NordVPN": "nordvpn",
            "Proton VPN": "protonvpn",
            "Surfshark": "surfshark",
            "Booking.com": "booking",
            "Airbnb": "airbnb"
          }
        },
        {
          "key": "iconImage",
          "title": "Icon image",
          "description": "Square PNG, JPEG or WebP. A PNG with transparency is also used for the themed and notification icons.",
          "required": false,
          "type": "kotlin.String",
          "default": null,
          "values": null
        },
        {
          "key": "background",
          "title": "Icon background",
          "description": "Shown behind the icon image.",
          "required": false,
          "type": "kotlin.String",
          "default": "#FFFFFF",
          "values": null
        },
        {
          "key": "fullBleed",
          "title": "Fill the icon",
          "description": "Stretch the image to the icon edge (photos). Off leaves a margin (logos).",
          "required": false,
          "type": "kotlin.Boolean",
          "default": false,
          "values": null
        },
        {
          "key": "silhouette",
          "title": "Silhouette image",
