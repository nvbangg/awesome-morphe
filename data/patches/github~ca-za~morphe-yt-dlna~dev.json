    {
      "name": "DLNA session notifications",
      "description": "Shows a notification when a DLNA renderer in the Wi-Fi plays a title cast with the \"DLNA cast\" patch from any phone (\"Playing on <device>\"). Searches briefly when the phone joins an unmetered network and about every 20 minutes on one, in a separate lightweight process; nothing runs in between. Resumes after a reboot without opening the app. Its buttons start a remote control (media session with lock screen controls and the renderer's volume on the volume keys) that steps aside as soon as the phone plays something itself.",
      "default": false,
      "category": null,
      "compatiblePackages": [
        {
          "packageName": "com.google.android.apps.youtube.music",
          "name": "YouTube Music",
          "description": null,
          "apkFileType": "APK_REQUIRED",
          "appIconColor": "#FF0000",
