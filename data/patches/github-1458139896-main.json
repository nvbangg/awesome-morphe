{
    "version": "1.1.0",
    "patches": [
        {
            "name": "Shuffle+",
            "description": "Long-press Now Playing's shuffle button to play the current playlist, album or Liked Songs in a truly random (Fisher-Yates, SecureRandom) order, with Spotify's own shuffle off.",
            "default": true,
            "category": null,
            "compatiblePackages": [
                {
                    "packageName": "com.spotify.music",
                    "name": "Spotify",
                    "description": null,
                    "apkFileType": "APKM",
                    "appIconColor": "#1DB954",
                    "signatures": null,
                    "targets": [
                        {
                            "version": "9.2.0.2053",
                            "versionCodes": {
                                "ARM64_V8A": 148387875
                            },
                            "isExperimental": true,
                            "minSdk": null,
                            "description": "Only the hooks verified on this build."
                        },
                        {
                            "version": "9.1.94.1929",
                            "versionCodes": {
                                "ARM64_V8A": 147600575
                            },
                            "isExperimental": true,
                            "minSdk": null,
                            "description": "Only the hooks verified on this build."
                        }
                    ]
                }
            ],
            "options": [
                {
                    "key": "tapShuffles",
                    "title": "Tap shuffles",
                    "description": "A tap on the shuffle button runs Shuffle+ too, instead of Spotify's own shuffle.",
                    "required": false,
                    "type": "kotlin.Boolean",
                    "default": false,
                    "values": null
                },
                {
                    "key": "commandShuffles",
                    "title": "Shuffle from car screens and other controls",
                    "description": "Turning shuffle on from Android Auto or any other control runs Shuffle+ instead of Spotify's own shuffle.",
                    "required": false,
                    "type": "kotlin.Boolean",
                    "default": false,
                    "values": null
                },
                {
                    "key": "recentHours",
                    "title": "Played-song window (hours)",
                    "description": "Songs played in the last N hours go to the end of a shuffle. 0 turns this off.",
                    "required": false,
                    "type": "kotlin.Int",
                    "default": 24,
                    "values": null
                }
            ]
        }
    ]
}