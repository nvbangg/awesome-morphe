        {
            "name": "Bypass Play Services checks",
            "description": "Makes Maps' bundled Play services signature and availability checks always pass, so it runs re-signed and with Play services disabled or absent, and lets it load tiles, search and routing by sending Google's own package and certificate in the identity headers the Maps backend checks. Where Play services rejects the re-signed app, Maps degrades instead of crashing. Also skips Google's \"isn't Play Protect certified\" page, and with no Play services at all uses Android's own Cronet so the map still loads.",
            "default": true,
            "category": null,
            "compatiblePackages": [
                {
                    "packageName": "com.google.android.apps.maps",
