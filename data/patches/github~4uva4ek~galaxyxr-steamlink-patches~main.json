      "options": [
        {
          "key": "compensationMs",
          "title": "Pose time compensation (ms)",
          "description": "How far before the runtime's label each controller pose is dated. Lower values shorten SteamVR's prediction: steadier, but the hands trail slightly. Higher values lengthen it: more responsive, but fast moves can overshoot and jerk. 0 ms sends the runtime's label unchanged; 29 ms is closest to the true sample time. Default: 5 ms. Allowed range: 0 to 30 ms. Change it with adb shell setprop debug.gxr.pose_time.lead_us <microseconds> without repatching.",
          "required": true,
          "type": "kotlin.Int",
          "default": 5,
          "values": null
        }
      ]
    },
