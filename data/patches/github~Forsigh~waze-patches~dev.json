{
  "NOTE": "Do NOT manually edit this file. This file is automatically updated when semantic release (release.yml) runs. Manually editing this file can break your releases and break third party tools that use this file.",
  "version": "0.27.0",
  "patches": [
    {
      "name": "Add your own media apps as Waze audio partners",
      "description": "Waze's audio-partner list is a table compiled into the app - it contains Spotify and an internal demo, and Waze never scans installed apps (getInstalledPackages has zero references in the APK). One patch for the whole media feature: it adds your own entries to that table at the point where Waze persists each partner's scope, and declares the media browser service in Waze's manifest, without which Android hides your players from Waze entirely. Waze's own availability check is opened as well: any installed app qualifies as a partner, and Waze reaches it through the generic media-browser client instead of requiring Waze's own SDK.",
      "default": false,
      "category": null,
      "dependencies": [
        "ResourcePatch",
        "BytecodePatch",
        "BytecodePatch"
      ],
      "compatiblePackages": [
        {
          "packageName": "com.waze",
          "name": "Waze",
          "description": null,
          "apkFileType": "APKM",
          "appIconColor": "#33CCFF",
          "signatures": null,
          "targets": [
            {
              "version": "5.24.90.901",
              "versionCodes": null,
              "isExperimental": false,
              "minSdk": null,
              "description": null
            },
            {
              "version": "5.25.0.1",
              "versionCodes": null,
              "isExperimental": false,
              "minSdk": null,
              "description": null
            },
            {
              "version": "5.25.4.900",
              "versionCodes": null,
              "isExperimental": false,
              "minSdk": null,
              "description": null
            },
            {
              "version": null,
              "versionCodes": null,
              "isExperimental": true,
              "minSdk": null,
              "description": null
            }
          ]
        }
      ],
      "options": [
        {
          "key": "alsoAllowPackage",
          "title": "Extra packages to make visible (one per line)",
          "description": "Package names to declare individually, for an app that does not expose a media browser service. Leave empty for none.",
          "required": false,
          "type": "kotlin.String",
          "default": "",
          "values": null
        },
        {
          "key": "mediaBrowserAction",
          "title": "Service action to declare",
          "description": "The action Waze is allowed to query for. The default is the standard Android media browser service, which every player capable of Android Auto support implements.",
          "required": false,
          "type": "kotlin.String",
          "default": "android.media.browse.MediaBrowserService",
          "values": null
        },
        {
          "key": "allowAllPackages",
          "title": "Let Waze see every installed app",
          "description": "Adds the QUERY_ALL_PACKAGES permission instead of a targeted declaration. The blunt version: use it only if the targeted declaration is not enough, and expect Waze to learn about apps it has no use for.",
          "required": false,
          "type": "kotlin.Boolean",
          "default": false,
          "values": null
        },
        {
          "key": "partners",
          "title": "Partners to add (package=Label)",
          "description": "One entry per partner, comma separated, written package=Label. The label defaults to the package when omitted. Each app must expose an android.media.browse.MediaBrowserService for Waze to be able to reach it.",
          "required": false,
          "type": "kotlin.String",
          "default": "app.morphe.android.apps.youtube.music=YouTube Music Morphe, ak.alizandro.smartaudiobookplayer=Smart Audiobook Player",
          "values": null
        },
        {
          "key": "enableAudioSdk",
          "title": "Turn Waze's audio-partner feature on",
          "description": "Forces CONFIG_VALUE_AUDIO_EXTENSION_SDK_FEATURE_ENABLED and CONFIG_VALUE_AUDIO_EXTENSION_SDK_ON to true. Without them Waze builds an empty partner list and the entries above would never be reached.",
          "required": false,
          "type": "kotlin.Boolean",
          "default": true,
          "values": null
        }
      ]
    },
    {
      "name": "Allow high refresh rate",
      "description": "Waze rejects any display mode above 60 Hz when it picks the mode for its surface, so a 120 Hz screen is served 60 Hz. This raises that ceiling to the requested rate (120 Hz by default). Costs battery and heat - off by default.",
